{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "finds-you-jobs",
  "version": "0.5.6",
  "identifier": "com.finds-you-jobs.app",
  "build": {
    "beforeDevCommand": "node scripts/dev-frontend.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "finds-you-jobs",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2RUJCQkFEMTNCOTNDNTEKUldSUlBMa1RyYnZyaHZ1Y1JDb2NvMFJpUVE5ZXpSMmxHQmh5SXpZSk1uVGlJc2dEV1F0eUdyVDUK",
      "endpoints": [
        "https://github.com/SrinivasRavi/finds-you-jobs/releases/download/latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© Srinivas Ravi",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/fyj-sidecar/": "sidecar/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    }
  }
}
